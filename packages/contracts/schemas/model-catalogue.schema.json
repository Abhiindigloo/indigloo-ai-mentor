{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indigloo.co/schemas/model-catalogue.schema.json",
  "title": "Model catalogue response",
  "description": "Matches GET /v1/models/catalog (ADR 0004). Inputs: age_band, board, language, device_ram_mb.",
  "type": "object",
  "required": ["models"],
  "properties": {
    "catalog_version": { "type": "string" },
    "signature": { "type": "string" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model_id", "version", "url", "size_bytes", "sha256", "licence", "runtime", "min_ram_mb"],
        "properties": {
          "model_id": { "type": "string" },
          "version": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "licence": {
            "type": "object",
            "required": ["id", "url"],
            "properties": {
              "id": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          },
          "runtime": { "type": "string", "enum": ["litertlm"] },
          "min_ram_mb": { "type": "integer", "minimum": 512 }
        }
      }
    }
  }
}
