DATABASE_PATH=/data/mentor.db
# Optional NIM or Hugging Face dedicated endpoint with OpenAI-compatible API.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Reverse-proxy addresses whose X-Forwarded-For is trusted for client IPs (rate limits).
# compose.yaml defaults to the Docker bridge range; set your proxy IP for other setups.
FORWARDED_ALLOW_IPS=
